/* ── Fix: Chinese font priority for post body, ensures em-dash renders correctly ── */
.post-body {
  font-family: "Microsoft YaHei", "PingFang SC", Lato, sans-serif;
}

/* Force sidebar avatar to perfect circle */
.site-author-image {
  width: 120px;
  height: 120px;
  object-fit: cover;
  border-radius: 50%;
}

/* ── Floating controls: shared tokens ── */
:root {
  --ctl-bg: #f4f2ed;
  --ctl-surface: #fbfaf7;
  --ctl-ink: #161514;
  --ctl-muted: #6f6a63;
  --ctl-line: rgba(22,21,20,.12);
  --ctl-line-strong: rgba(22,21,20,.24);
  --ctl-accent: #2f63e8;
  --ctl-radius: 14px;
  --ctl-ease: cubic-bezier(.22,1.18,.36,1);
  --ctl-shadow: 0 12px 32px rgba(22,21,20,.10);
}
.darkmode--activated {
  --ctl-bg: #161514;
  --ctl-surface: #1d1b19;
  --ctl-ink: #f2efe9;
  --ctl-muted: #a09a92;
  --ctl-line: rgba(255,255,255,.12);
  --ctl-line-strong: rgba(255,255,255,.24);
  --ctl-accent: #7f9cff;
  --ctl-shadow: 0 12px 32px rgba(0,0,0,.45);
}

/* ── KaTeX 公式：过宽时在版心内横向滚动（居中与滚动共存）── */
/* 说明：KaTeX 的 .katex-display 自身是 text-align:center；直接用
   text-align 居中 + overflow 在超宽时会把左端推到滚动区外，
   故改用 flex + 子元素 margin:0 auto —— 放得下时居中，
   放不下时 auto 归零、从左边开始，两端都滚得到。          */
.post-body .katex-display {
  display: flex;
  overflow-x: auto;
  overflow-y: hidden;
}
.post-body .katex-display > .katex {
  margin: 0 auto;
}

/* ── 表格：长链接不撑破版心，窄屏在版心内横向滚动 ── */
/* 主题已给 .table-container 加了 overflow:auto，这里补两点：
   1) 无空格长串（URL、代码）允许断行，避免把表格撑出内容区；
   2) 触摸设备保留惯性滚动，窄屏收紧单元格内边距。
   注意：不要给首列加 white-space:nowrap —— 其他文章的首列是
   中文短语，禁止折行反而会把表格撑宽。                     */
.post-body .table-container {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.post-body table th,
.post-body table td {
  overflow-wrap: anywhere;
  word-break: break-word;
}
@media (max-width: 767px) {
  .post-body table th,
  .post-body table td {
    padding: 6px 8px;
  }
}

/* ── H-01: shared Songti headings and a restrained article-link band ── */
.site-title {
  font-family: "Songti SC", "STSong", "SimSun", "Noto Serif CJK SC", serif;
  letter-spacing: .04em;
}

.index.posts-expand .post-block {
  position: relative;
  isolation: isolate;
}
.index.posts-expand .post-block::before {
  content: '';
  position: absolute;
  top: -12px;
  left: -20px;
  right: -20px;
  height: 96px;
  border-radius: 8px;
  background: unquote("rgba(var(--sky-accent-rgb), .06)");
  opacity: 0;
  pointer-events: none;
  z-index: -1;
  transition: opacity 120ms ease;
}
.index.posts-expand .post-block:has(.post-title-link:focus-visible)::before,
.index.posts-expand .post-block:has(.post-title-link:active)::before {
  opacity: 1;
}
@media (hover: hover) {
  .index.posts-expand .post-block:has(.post-title-link:hover)::before {
    opacity: 1;
  }
}
.index.posts-expand .post-title {
  font-family: "Songti SC", "STSong", "SimSun", "Noto Serif CJK SC", serif;
  font-size: calc(27px * var(--sky-title-scale));
  line-height: 1.4;
  letter-spacing: .02em;
  text-wrap: pretty;
}
.index.posts-expand .post-title-link {
  transition: color 120ms ease;
}
.index.posts-expand .post-title-link:hover,
.index.posts-expand .post-title-link:active,
.index.posts-expand .post-title-link:focus-visible {
  color: unquote("rgb(var(--sky-accent-rgb))");
}
.index.posts-expand .post-title-link:focus-visible {
  outline: unquote("1px solid rgb(var(--sky-accent-rgb))");
  outline-offset: 5px;
  border-radius: 2px;
}
.index.posts-expand .post-title-link::before {
  background: unquote("rgb(var(--sky-accent-rgb))");
  height: 1px;
}
.index.posts-expand .post-meta {
  font-size: 12px;
  line-height: 1.8;
  margin-top: 9px;
  color: unquote("rgb(var(--sky-muted-rgb))");
  font-variant-numeric: tabular-nums;
}
.index.posts-expand .post-meta-item {
  display: inline-block;
  vertical-align: baseline;
}
.index.posts-expand .post-meta .post-meta-item + .post-meta-item::before {
  margin: 0 .7em;
}
.index.posts-expand .post-meta time {
  border-bottom-color: unquote("rgba(var(--sky-line-rgb), .7)");
}
.index.posts-expand .post-meta a {
  color: inherit;
  border-bottom-color: unquote("rgba(var(--sky-line-rgb), .7)");
}

@media (max-width: 767px) {
  .index.posts-expand .post-title {
    font-size: calc(23px * var(--sky-title-scale));
    line-height: 1.45;
  }
  .index.posts-expand .post-meta {
    font-size: 12px;
    line-height: 1.9;
    margin-top: 8px;
  }
  .index.posts-expand .post-block::before {
    left: -10px;
    right: -10px;
    height: 116px;
  }
}

/* The homepage's existing floating player follows the same OS theme as NexT. */
@media (prefers-color-scheme: dark) {
  #miniPlayer, #mpPlaylist {
    background: unquote("rgba(var(--sky-paper-rgb), .96)");
    border-color: unquote("rgba(var(--sky-line-rgb), .55)");
    box-shadow: unquote("0 4px 24px rgba(var(--sky-paper-rgb), .4)");
  }
  #mpOverlay { background: unquote("rgba(var(--sky-paper-rgb), .45)"); }
  .mp-ctrl, #mpBtn {
    background: unquote("rgb(var(--sky-panel-rgb))");
    border-color: unquote("rgba(var(--sky-line-rgb), .6)");
    color: unquote("rgb(var(--sky-muted-rgb))");
  }
  .mp-ctrl:hover, #mpBtn:hover {
    border-color: unquote("rgb(var(--sky-line-rgb))");
    color: unquote("rgb(var(--sky-ink-rgb))");
  }
  #mpTitle, .mpp-name { color: unquote("rgb(var(--sky-ink-rgb))"); }
  .mpp-num, .mpp-artist { color: unquote("rgb(var(--sky-muted-rgb))"); }
  .mpp-row:hover { background: unquote("rgb(var(--sky-field-rgb))"); }
  .mpp-row.active { background: unquote("rgb(var(--sky-panel-rgb))"); }
  .mpp-row.active .mpp-num { color: unquote("rgb(var(--sky-ink-rgb))"); }
  #mpDisc, #mpDisc:hover, #mpDisc.expanded {
    box-shadow: unquote("0 0 0 3px rgb(var(--sky-line-rgb)), inset 0 0 0 2px rgb(var(--sky-paper-rgb))");
  }
  .back-to-top {
    background: unquote("rgb(var(--sky-panel-rgb))");
    color: unquote("rgb(var(--sky-muted-rgb))");
  }
  .back-to-top:hover { color: unquote("rgb(var(--sky-accent-rgb))"); }
  .b2t-disc {
    background: unquote("conic-gradient(rgb(var(--sky-line-rgb)) 0deg 90deg, rgb(var(--sky-panel-rgb)) 90deg 180deg, rgb(var(--sky-line-rgb)) 180deg 270deg, rgb(var(--sky-panel-rgb)) 270deg 360deg)");
  }
}

@media (prefers-reduced-motion: reduce) {
  .index.posts-expand .post-block::before,
  .index.posts-expand .post-title-link { transition: none; }
}
